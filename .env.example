# Supabase Configuration
# Get these from your Supabase project dashboard at https://supabase.com
# 1. Create a new project or use existing
# 2. Go to Settings > API to find these values

# Your Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anonymous Public Key (from Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: For demo mode only, leave both above empty or commented:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

